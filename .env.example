# ─────────────────────────────────────────────────────────────────────────────
#  MEGAKART — environment template
#
#  Copy to `.env` for local work. `.env` is git-ignored and must stay that way.
#  In production every one of these is set in RENDER'S ENVIRONMENT, never here.
#
#  NOTHING IN THIS FILE IS A REAL VALUE. Placeholders only.
# ─────────────────────────────────────────────────────────────────────────────


# ── Local timing bridge (venue PC only) ──────────────────────────────────────
# Read-only tap on the GoKarts live feed. Never leaves the venue LAN.

# Host publishing the GoKarts feed. Almost always the timing PC itself.
APEX_HOST=127.0.0.1

# The feed port is DYNAMIC: idle sits on 30001, an armed session N moves to
# 30000+N. The bridge scans BASE..BASE+RANGE and picks the active one, so these
# are a search window, not a fixed port.
APEX_FEED_BASE=30001
APEX_FEED_RANGE=12

# Kept for compatibility; discovery uses BASE/RANGE above.
APEX_FEED_PORT=30001

# HTTP port the bridge serves /live, /stream, /chrono and /karts on.
BRIDGE_PORT=8787

# Replay a captured session instead of the live feed (development only).
# Leave EMPTY in production — a bridge in replay mode shows a recording while
# looking completely normal, which is the worst way to discover a mistake.
APEX_REPLAY=
APEX_REPLAY_LOOP=

# Where GoServer re-exports the day's session plan.
APEX_SESSIONS_JSON=C:\MegaK\ApexImport\sessions.json


# ── Reservation desk (venue PC only) ─────────────────────────────────────────
# Serves the built bundle AND the reservations API from one origin, so no CORS
# headers exist anywhere in the system.

DESK_PORT=8788

# Built bundle to serve. Defaults to ./dist/client.
DESK_STATIC=

# Where reservations are stored. CONTAINS PERSONAL DATA — keep it outside the
# repo. Defaults to %LOCALAPPDATA%\MegaKart on Windows.
DESK_DATA=


# ── Cloud sync: venue → Render ───────────────────────────────────────────────
# The local agent pushes outbound over HTTPS. There is no inbound connection,
# so the venue needs no port forwarding and no firewall exception.

# Base URL of the Render service.
MEGAKART_CLOUD_URL=https://your-service.onrender.com

# Bearer token identifying THIS venue to Render.
# SET THIS IN RENDER'S ENVIRONMENT AND IN THE LOCAL AGENT'S OWN .env — never
# commit a real one. If it ever lands in a commit, rotate it: git history is
# public forever once pushed.
MEGAKART_VENUE_TOKEN=replace-me-with-a-long-random-string

# Identifies the site when several venues report to one Render service.
MEGAKART_VENUE_ID=fes

# How often the agent pushes batched events, in milliseconds. One request per
# batch, not per crossing.
MEGAKART_PUSH_INTERVAL_MS=500


# ── Browser-side (compiled into the bundle — PUBLIC) ──────────────────────────
# Anything prefixed VITE_ is embedded in the JavaScript shipped to phones and
# is readable by anyone. NEVER put a secret behind a VITE_ prefix.

# Where the browser reaches the local bridge. Empty = http://localhost:8787.
VITE_APEX_BRIDGE_URL=

# Where the browser reaches the reservations API. Empty = same origin, which is
# what you want when the desk serves the bundle.
VITE_RESERVATIONS_URL=

# Public site URL, used for QR codes and share links.
VITE_PUBLIC_SITE_URL=https://mega-karts.web.app


# ── Dev only ─────────────────────────────────────────────────────────────────
# Vite proxies /api to the desk server during development.
DESK_URL=http://127.0.0.1:8788

# Keep Wrangler/Miniflare state project-local. Tool settings, not secrets.
WRANGLER_LOG_PATH=.wrangler/wrangler.log
WRANGLER_WRITE_LOGS=false
MINIFLARE_REGISTRY_PATH=.wrangler/registry
