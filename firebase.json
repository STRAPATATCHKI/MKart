{
  "hosting": {
    "public": "dist/inscription",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/inscription.html"
      },
      {
        "source": "/s",
        "destination": "/app.html"
      },
      {
        "source": "/s/**",
        "destination": "/app.html"
      }
    ],
    "redirects": [
      {
        "source": "/i",
        "destination": "/inscription.html",
        "type": 302
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
