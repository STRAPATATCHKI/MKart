{
  "hosting": {
    "public": "dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/i",
        "destination": "/inscription.html",
        "type": 302
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
